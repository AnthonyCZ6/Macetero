# Plantilla de variables de entorno — copia a `web/.env.local` (Next.js)
# y/o `.env` en la raíz (prisma, scripts de server/). NUNCA subas los valores reales.

# --- Base de datos (Prisma / Postgres) ---
DATABASE_URL=
DIRECT_URL=

# --- Cifrado de wallets (AES-256-GCM) ---
# 64 caracteres hex (32 bytes). Genera uno con: openssl rand -hex 32
WALLET_ENCRYPTION_KEY=

# --- Sesiones (cookie firmada con HMAC) ---
# Mínimo 32 caracteres. Genera uno con: openssl rand -hex 32
# Si se deja vacío se deriva de WALLET_ENCRYPTION_KEY. Cambiarlo cierra todas las sesiones.
SESSION_SECRET=

# --- Cron jobs (/api/cron/*) ---
# Las rutas de cron exigen `Authorization: Bearer <CRON_SECRET>` (GET o POST).
# En Vercel, definir CRON_SECRET hace que Vercel Cron lo mande automáticamente
# (horarios en web/vercel.json).
CRON_SECRET=
# Zona horaria para contar días de retraso y recordatorios.
APP_TIMEZONE=America/Mexico_City

# --- Administración ---
# `Authorization: Bearer <ADMIN_API_SECRET>` para POST /api/trustless/deploy (Postman).
# Vacío = el endpoint queda deshabilitado.
ADMIN_API_SECRET=

# --- Etherfuse ---
ETHERFUSE_BASE_URL=https://api.sand.etherfuse.com
ETHERFUSE_API_KEY=
# Obligatorio en producción: sin él el webhook responde 503.
ETHERFUSE_WEBHOOK_SECRET=

# --- Stellar ---
STELLAR_NETWORK_PASSPHRASE=
NEXT_PUBLIC_RPC_URL=https://soroban-testnet.stellar.org
NEXT_PUBLIC_NETWORK_PASSPHRASE=
NEXT_PUBLIC_NATIVE_TOKEN_CONTRACT=
NEXT_PUBLIC_STELLAR_EXPERT_CONTRACT_BASE=

# --- Wallet passkey (smart-account-kit / WebAuthn) ---
NEXT_PUBLIC_ACCOUNT_WASM_HASH=
NEXT_PUBLIC_WEBAUTHN_VERIFIER_ADDRESS=
# Opcional: por defecto el hostname actual (usa localhost, no 127.0.0.1)
NEXT_PUBLIC_RP_ID=

# --- Trustless Work (solo servidor — la key ya NO se expone con NEXT_PUBLIC_) ---
TRUSTLESS_WORK_ENABLED=true
TRUSTLESS_WORK_BASE_URL=https://dev.api.trustlesswork.com
TRUSTLESS_WORK_API_KEY=
# Cuenta que firma los deploys (clave S…). Alias: TRUSTLESS_WORK_OPERATOR_SECRET
TRUSTLESS_SIGNER_SECRET=
# Roles opcionales (G… públicos y sus S… si difieren del signer)
TRUSTLESS_TEAM_WALLET_G=
TRUSTLESS_APPROVER_G=
TRUSTLESS_DISPUTE_RESOLVER_G=
TRUSTLESS_SERVICE_PROVIDER_G=
TRUSTLESS_PLATFORM_ADDRESS_G=
TRUSTLESS_RELEASE_SIGNER_G=
TRUSTLESS_APPROVER_SECRET=
TRUSTLESS_SERVICE_PROVIDER_SECRET=
TRUSTLESS_RELEASE_SIGNER_SECRET=
TRUSTLESS_DISPUTE_RESOLVER_SECRET=
TRUSTLESS_PLATFORM_SECRET=
TRUSTLESS_USE_IMPACTA_ROLE_DEFAULTS=false

# --- Trustline del escrow (USDC testnet por defecto) ---
TRUSTLINE_ISSUER_G=
TRUSTLINE_SYMBOL=USDC

# --- Flags de la app ---
# true = los pagos solo se registran en BD (sin Stellar ni escrow)
TANDA_PAY_VISUAL_ONLY=false
# true = al crear una tanda se inserta un escrow simulado; úsalo junto con TANDA_PAY_VISUAL_ONLY=true
SIMULATE_ESCROW_ON_CREATE=false
